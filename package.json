{
	"name": "elliott-richmond",
	"version": "1.0.0",
	"description": "elliott richmond personal theme 2025",
	"main": "index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eirichmond/elliott-richmond.git"
	},
	"keywords": [
		"WordPress",
		"theme"
	],
	"author": "Elliott Richmond",
	"license": "GPL-2.0-or-later",
	"bugs": {
		"url": "https://github.com/eirichmond/elliott-richmond/issues"
	},
	"homepage": "https://github.com/eirichmond/elliott-richmond#readme",
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"devDependencies": {
		"@wordpress/stylelint-config": "^22.5.0",
		"stylelint": "^14.16.1",
		"grunt": "~0.4.5",
		"grunt-wp-i18n": "~0.5.0",
		"grunt-wp-readme-to-markdown": "~1.0.0"
	},
	"scripts": {
		"start": "grunt default",
		"readme": "grunt readme",
