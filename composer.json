{
	"name": "elliottrichmond/elliott-richmond",
	"description": "elliott richmond personal theme 2025",
	"keywords": [
		"WordPress",
		"Themes"
	],
	"homepage": "https://github.com/eirichmond/elliott-richmond.git",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Elliott Richmond",
			"homepage": "https://elliottrichmond.co.uk",
			"email": "elliott@squareonemd.co.uk"
		}
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"scripts": {
		"format": "phpcbf --standard=phpcs.xml.dist --report-summary --report-source",
		"lint": "phpcs --standard=phpcs.xml.dist"
	}
}
